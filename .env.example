# email-nf-onedrive: modelo do arquivo .env
# Copie para .env, preencha e proteja com: chmod 600 .env
# Nunca versione o .env real.

# --- Caixas de e-mail -------------------------------------------------------
# Uma caixa por índice <n> (1, 2, 3...). Lacunas na numeração são aceitas.
# SENHA_EMAIL<n> é a senha de app do Google (exige verificação em duas etapas),
# não a senha comum da conta.
EMAIL1=financeiro@empresa.example
SENHA_EMAIL1=abcdabcdabcdabcd
# Pasta ou marcador monitorado. Padrão: INBOX
PASTA_EMAIL1=INBOX
# Servidor IMAP. Padrão: imap.gmail.com (porta 993, TLS)
# IMAP_HOST_EMAIL1=imap.gmail.com
# Destino próprio desta caixa. Padrão: o valor de DESTINO_ONEDRIVE
# DESTINO_ONEDRIVE1=Financeiro/CONTAS A PAGAR

# Segunda caixa (exemplo):
# EMAIL2=administrativo@outra-empresa.example
# SENHA_EMAIL2=efghefghefghefgh
# PASTA_EMAIL2=INBOX

# --- OneDrive via Rclone ----------------------------------------------------
# Nome do remote criado com "rclone config" (tipo onedrive, business)
RCLONE_REMOTE=onedrive-financeiro
# Pasta de destino, relativa à raiz do remote
DESTINO_ONEDRIVE=Financeiro/CONTAS A PAGAR

# --- Coleta -----------------------------------------------------------------
# Primeira data a considerar nas caixas sem histórico (AAAA-MM-DD).
# Uma data antiga envia todo o histórico para o OneDrive.
DATA_INICIAL=2026-09-01

# --- Aviso de falhas pelo Telegram -----------------------------------------
# Defina as duas ou nenhuma. Sem elas, as falhas ficam só no log.
TELEGRAM_BOT_TOKEN=123456789:token-ficticio-do-botfather
TELEGRAM_CHAT_ID=123456789

# --- Agendamento (cron do usuário de serviço) -------------------------------
# */30 * * * * cd /opt/email-nf-onedrive && ./.venv/bin/email-nf-onedrive executar >/dev/null 2>&1
