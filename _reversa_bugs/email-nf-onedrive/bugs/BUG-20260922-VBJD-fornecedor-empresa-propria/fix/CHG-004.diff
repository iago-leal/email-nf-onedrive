+def _dominio(endereco: str) -> str:
+    return endereco.strip().lower().rpartition("@")[2] if "@" in endereco else ""
+
+
+def dominios_internos(enderecos) -> frozenset[str]:
+    """Domínios das caixas, menos os provedores genéricos: uma caixa `@gmail.com` não torna interno todo Gmail."""
+    dominios = {_dominio(e) for e in enderecos}
+    return frozenset(d for d in dominios if d and d.split(".", 1)[0] not in DOMINIOS_GENERICOS)
