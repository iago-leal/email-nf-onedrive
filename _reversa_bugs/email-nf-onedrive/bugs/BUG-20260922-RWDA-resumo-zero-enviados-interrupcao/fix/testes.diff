@@ -179,3 +182,68 @@ def test_home_por_variavel_de_ambiente(cenario, monkeypatch, capsys):
     monkeypatch.setenv("EMAIL_NF_HOME", str(cenario.home))
     assert main(["verificar-config"]) == 0
